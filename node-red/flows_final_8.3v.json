    {
        "id": "c2e7b2415545593f",
        "type": "function",
        "z": "adaf3a0a2a40c5bb",
        "name": "OEE Calculation Engine",
        "func": "// ==========================================\n// ⚙️ OEE Calculation Engine (update:แก้ไขตรรกะเวลาและสถานะสายพาน)\n// ==========================================\n\nlet now = Date.now();\n\n// 1. ดึงข้อมูลจาก Memory (Flow Context)\nlet total = flow.get(\"totalCount\") ?? 0;\nlet good = flow.get(\"goodCount\") ?? 0;\nlet waste = flow.get(\"wasteCount\") ?? 0;\n\nlet lastObjectTime = flow.get(\"lastObjectTime\") || now;\nlet startTime = flow.get(\"startTime\") || now;\nlet lastTime = flow.get(\"lastTime\") || now;\nlet runningTimeSec = flow.get(\"runningTimeSec\") || 0;\n\nif (!flow.get(\"startTime\")) {\n    flow.set(\"startTime\", startTime);\n}\n\n// ---------------------------------------------------------\n// 2. คำนวณเวลาและสถานะสะสม (ต้องทำก่อนอัปเดตข้อมูลใหม่)\n// ---------------------------------------------------------\nlet timeDiff = (now - lastTime) / 1000; // วินาทีที่ผ่านไปนับจากรอบก่อน\nlet idleTimeoutMs = 60000; // 60 วินาที\n\n// เช็คสถานะ \"ช่วงที่ผ่านมา\" ว่าทำงานหรือหยุด (ก่อนมีชิ้นงานใหม่เข้ามา)\nlet status = 1; // 1 = RUNNING, 0 = STOPPED\nif ((now - lastObjectTime) > idleTimeoutMs) {\n    status = 0; \n}\n\n// สะสมเวลาเฉพาะช่วงที่สถานะเป็น RUNNING และเวลาไม่กระโดดเกินจริง (เช่น เกิน 2 นาที)\nif (status === 1 && timeDiff > 0 && timeDiff < 120) {\n    runningTimeSec += timeDiff;\n}\n\n// อัปเดตจุดอ้างอิงเวลาสำหรับการคำนวณรอบถัดไป\nflow.set(\"lastTime\", now);\nflow.set(\"runningTimeSec\", runningTimeSec);\n\n// ---------------------------------------------------------\n// 3. รับและอัปเดตข้อมูลจาก MQTT\n// ---------------------------------------------------------\nif (msg.topic === \"factory/conveyor/total\") {\n    total = Math.max(0, Number(msg.payload));\n    flow.set(\"totalCount\", total);\n    lastObjectTime = now;\n} else if (msg.topic === \"factory/conveyor/good\") {\n    good = Math.max(0, Number(msg.payload));\n    flow.set(\"goodCount\", good);\n    lastObjectTime = now;\n} else if (msg.topic === \"factory/conveyor/waste\") {\n    waste = Math.max(0, Number(msg.payload));\n    flow.set(\"wasteCount\", waste);\n    lastObjectTime = now;\n}\n\n// เซฟเวลาล่าสุดที่มีของผ่านสายพาน\nflow.set(\"lastObjectTime\", lastObjectTime);\n\n// ถ้ารอบนี้มีของผ่าน (lastObjectTime เพิ่งถูกอัปเดต) ให้สถานะปัจจุบันกลับมาเป็น RUNNING ทันที\nif ((now - lastObjectTime) <= idleTimeoutMs) {\n    status = 1;\n}\nflow.set(\"conveyorStatus\", status);\n\n// ---------------------------------------------------------\n// 4. คำนวณดัชนี OEE \n// ---------------------------------------------------------\n\n// A - Quality (%)\nlet quality = total > 0 ? (good / total) * 100 : 100;\nquality = Math.min(100, Math.max(0, quality));\n\n// B - Availability (%)\nlet totalPlannedTime = (now - startTime) / 1000;\nlet availability = totalPlannedTime > 0 ? (runningTimeSec / totalPlannedTime) * 100 : 100;\navailability = Math.min(100, Math.max(0, availability));\n\n// C - Performance (%)\nlet idealCycleTime = 5; // เวลามาตรฐาน 5 วินาที / ชิ้น\nlet expectedOutput = runningTimeSec / idealCycleTime;\nlet performance = 100;\n\nif (runningTimeSec > 0 && expectedOutput > 0) {\n    performance = (total / expectedOutput) * 100;\n}\nperformance = Math.min(100, Math.max(0, performance));\n\n// ดัชนีรวม OEE (%)\nlet oee = (availability / 100) * (performance / 100) * (quality / 100) * 100;\n\n// ---------------------------------------------------------\n// 5. บีบข้อมูลส่งออก\n// ---------------------------------------------------------\nlet statusText = (status === 1) ? \"🟢 กำลังทำงาน (RUNNING)\" : \"🔴 หยุดทำงาน (IDLE/STOPPED)\";\n\nlet dataPayload = {\n    total: total,\n    good: good,\n    waste: waste,\n    status: status,\n    statusText: statusText,\n    availability: parseFloat(availability.toFixed(1)),\n    performance: parseFloat(performance.toFixed(1)),\n    quality: parseFloat(quality.toFixed(1)),\n    oee: parseFloat(oee.toFixed(1)),\n    // --- ส่วนที่เพิ่มเข้ามาใหม่ ---\n    running_time_sec: Math.round(runningTimeSec),\n    total_time_sec: Math.round(totalPlannedTime)\n};\n\nlet msgDash = { payload: dataPayload };\nlet msgInflux = {\n    payload: { ...dataPayload },\n    tags: { conveyor_id: \"LINE_01\" }\n};\n\nreturn [msgDash, msgInflux];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",

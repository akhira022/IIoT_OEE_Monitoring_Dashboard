# LOCAL DEVELOPMENT credentials for the docker-compose stack.
# These are throwaway values for running the stack on a developer machine.
# Do NOT reuse them anywhere real, and do NOT point production at this file.

# InfluxDB v2 initial setup
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=admin-dev-password
INFLUXDB_ORG=factory
INFLUXDB_BUCKET=conveyor_oee
INFLUXDB_TOKEN=dev-conveyor-oee-token-please-change

# Grafana admin login (anonymous access is also enabled for convenience)
GRAFANA_USERNAME=admin
GRAFANA_PASSWORD=admin
